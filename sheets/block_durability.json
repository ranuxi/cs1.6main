{
  "_about": "How much CS damage a block takes before a bullet (or knife, or HE grenade) breaks it. Every block not listed gets hp = base + scale * hardness^exponent from its Minecraft hardness, so dirt goes in one shot and obsidian takes about 6 AK-47 hits (36 each). Blocks with negative hardness (bedrock, barriers) never break. Damage on a block cracks it visibly and heals after healSeconds without hits. Broken blocks drop their items like mining.",
  "settings": {
    "columns": ["key", "value", "use"],
    "rows": [
      {"key": "enabled",     "value": 1,    "use": "1 = bullets break blocks, 0 = only chip them"},
      {"key": "base",        "value": 10,   "use": "hp of a block with hardness 0"},
      {"key": "scale",       "value": 13,   "use": "hp added per hardness^exponent"},
      {"key": "exponent",    "value": 0.7,  "use": "how fast hp grows with hardness"},
      {"key": "healSeconds", "value": 12,   "use": "damage on a block resets after this long without hits"},
      {"key": "heDamage",    "value": 1,    "use": "1 = HE grenades also damage blocks (falloff with distance)"}
    ]
  },
  "overrides": {
